#!/usr/bin/env bash
# PostgreSQL host bootstrap for the durexec EKS pilot.
# Terraform renders $${VAR} as a literal shell variable; $${} escapes it.
set -euo pipefail
exec > >(tee /var/log/durexec-db-bootstrap.log) 2>&1

dnf install -y docker
systemctl enable --now docker

# --- data volume -----------------------------------------------------------
# Nitro presents EBS as NVMe, so /dev/sdf is only a symlink and may be absent.
# Find the one non-root disk instead of trusting the requested name.
ROOT_DISK="$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null || true)"
DEVICE=""
for d in /dev/nvme*n1 /dev/xvd*; do
  [ -b "$d" ] || continue
  [ "$(basename "$d")" = "$${ROOT_DISK}" ] && continue
  lsblk -no MOUNTPOINT "$d" | grep -q . && continue
  DEVICE="$d"; break
done
if [ -z "$${DEVICE}" ]; then echo "FATAL: no data volume found"; exit 1; fi

# NEVER reformat a disk that already holds a filesystem. This is what lets the
# volume outlive the instance and still carry its journal.
if blkid "$${DEVICE}" >/dev/null 2>&1; then
  echo "EXISTING filesystem on $${DEVICE}; preserving it"
else
  echo "no filesystem on $${DEVICE}; creating ext4"
  mkfs -t ext4 -L durexec-pgdata "$${DEVICE}"
fi

mkdir -p /var/lib/durexec-pgdata
grep -q durexec-pgdata /etc/fstab || \
  echo 'LABEL=durexec-pgdata /var/lib/durexec-pgdata ext4 defaults,nofail 0 2' >> /etc/fstab
mount -a
# Postgres refuses to initdb into a non-empty directory and ext4 always has
# lost+found, so PGDATA is a subdirectory.
mkdir -p /var/lib/durexec-pgdata/pgdata
chown -R 999:999 /var/lib/durexec-pgdata

# --- credentials -----------------------------------------------------------
# Fetched from Secrets Manager with the instance role; user_data carries only
# the secret's ARN. Nothing below prints the value: stdout/stderr are tee'd to
# the bootstrap log, so the value is written straight to a 0600 file and the
# aws/python output never reaches the terminal. The instance profile can take
# a few seconds to become usable after launch, hence the retry.
install -d -m 0700 /opt/durexec
umask 077
SECRET_JSON=""
for i in $(seq 1 30); do
  if SECRET_JSON="$(aws secretsmanager get-secret-value --region "${aws_region}" \
        --secret-id "${db_secret_arn}" --query SecretString --output text 2>/dev/null)" \
     && [ -n "$${SECRET_JSON}" ]; then
    break
  fi
  echo "secret not readable yet (attempt $${i}/30); retrying"
  SECRET_JSON=""; sleep 5
done
if [ -z "$${SECRET_JSON}" ]; then echo "FATAL: could not read the database secret"; exit 1; fi
printf '%s' "$${SECRET_JSON}" | python3 -c '
import json, sys
d = json.load(sys.stdin)
sys.stdout.write("POSTGRES_PASSWORD=%s\nREPL_PASSWORD=%s\n" % (d["postgres_password"], d["replication_password"]))
' > /opt/durexec/.env
unset SECRET_JSON
chmod 0600 /opt/durexec/.env
umask 022
echo "credentials: written to /opt/durexec/.env (value not logged)"

# --- PostgreSQL ------------------------------------------------------------
# max_connections must cover every engine pod's pool plus renewal pools plus
# headroom. The Compose default of 100 caps the cluster at three nodes; the
# pilot needs room for more pods than that.
docker run -d --name durexec-postgres --restart unless-stopped \
  -p 5432:5432 \
  -e POSTGRES_DB=durexec \
  -e POSTGRES_USER=durexec \
  --env-file /opt/durexec/.env \
  -e PGDATA=/var/lib/postgresql/data/pgdata \
  -v /var/lib/durexec-pgdata:/var/lib/postgresql/data \
  pgvector/pgvector:pg16 \
  -c max_connections=${max_connections} \
  -c shared_buffers=1GB \
  -c synchronous_commit=on \
  -c wal_level=replica \
  -c max_wal_senders=4 \
  -c max_replication_slots=4 \
  -c shared_preload_libraries=pg_stat_statements \
  -c pg_stat_statements.track=all \
  -c track_io_timing=on \
  -c track_wal_io_timing=on \
  -c log_lock_waits=on \
  -c log_checkpoints=on \
  -c log_min_duration_statement=200
# The instrumentation above matches the local Kubernetes lab
# (deploy/kubernetes/base/10-config.yaml) so that cloud and local database
# figures come from the same sources. Without it the cloud run would have had
# no per-statement latency, no I/O timing and no lock-wait log, and a
# local-versus-cloud comparison would have compared different measurements.
# shared_buffers differs on purpose (1GB here, 256MB in the lab) and is
# recorded with every evidence bundle; the pilot database stays far smaller
# than either, so both serve from cache.

# A marker the deploy script waits on. Written last, so its presence means
# every step above succeeded.
for i in $(seq 1 60); do
  if docker exec durexec-postgres pg_isready -U durexec -d durexec >/dev/null 2>&1; then
    touch /opt/durexec/.db-ready
    echo "postgres ready after $${i}s"
    exit 0
  fi
  sleep 1
done
echo "FATAL: postgres did not become ready"
exit 1
