# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
#
# NOTHING SECRET BELONGS IN THIS FILE. The PostgreSQL, replication and Grafana
# passwords are generated by Terraform; AWS credentials come from the named
# profile in ~/.aws/credentials and are never read into Terraform's state.

# Required. Your own address, with a /32. Terraform refuses to plan without it
# and rejects 0.0.0.0/0 outright.
#   curl -s https://checkip.amazonaws.com
operator_cidr = "203.0.113.4/32"

# us-east-1 is AWS's cheapest region for every resource here.
aws_region = "us-east-1"

# Goes into every resource name, so two environments can coexist.
environment = "lab"

# 2 vCPU / 4 GiB. See the variable's own description for why not t3.small
# (the stack's memory limits total ~2.8 GiB with the streaming standby) and
# why not t4g.medium (19% cheaper, but arm64 images are unvalidated).
instance_type = "t3.medium"

# Public half only. Generate with:
#   ssh-keygen -t ed25519 -f ~/.ssh/durexec-aws -C durexec-aws
ssh_public_key_path = "~/.ssh/durexec-aws.pub"

# Set false for a deployment with no inbound rule at all, reached only through
# `aws ssm start-session`. Stricter, but with no fallback if the SSM agent
# fails to register.
enable_ssh = true

root_volume_gb = 20
data_volume_gb = 20

# Leave false so the documented teardown really does stop every charge. Set
# true only before a destroy that is meant to keep the journal for a later
# restore test -- the volume then has to be deleted by hand.
data_volume_retain_on_destroy = false

# Merged into every resource's tags.
extra_tags = {
  Owner  = "dharaneswar339"
  Course = "23AID498"
}
